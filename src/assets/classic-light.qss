/* PATM Classic Light — Qt QSS */
/* palette: window_bg=#ecebe8 base=#ffffff text=#1a1a1a highlight=#35507c */

QMainWindow, QDialog {
    background-color: #ecebe8;
    color: #1a1a1a;
}

QLabel { color: #1a1a1a; }
QLabel:disabled { color: #8d8c88; }

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #7f7f79;
    border-radius: 0px;
    padding: 3px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: #35507c; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #ecebe8; color: #8d8c88;
}
QLineEdit::placeholderText { color: #8d8c88; }

QSpinBox, QDoubleSpinBox {
    background-color: #ffffff; color: #1a1a1a;
    border: 1px solid #7f7f79; border-radius: 0px; padding: 3px 6px;
}

QPushButton {
    background-color: #ecebe8;
    color: #1a1a1a;
    border: 1px solid #9a9a94;
    border-radius: 0px;
    padding: 4px 12px;
}
QPushButton:hover { background-color: #ffffff; }
QPushButton:pressed { background-color: #d6d4ce; }
QPushButton:checked { background-color: #cfcdc7; }
QPushButton:disabled { background-color: #ecebe8; color: #8d8c88; }

QToolButton {
    background-color: #ecebe8;
    color: #1a1a1a;
    border: 1px solid #9a9a94;
    border-radius: 0px;
    padding: 4px 12px;
}
QToolButton:hover { background-color: #ffffff; }
QToolButton:pressed { background-color: #d6d4ce; }
QToolButton:checked { background-color: #cfcdc7; }
QToolButton:disabled { background-color: #ecebe8; color: #8d8c88; }

QListWidget, QListView { background-color: #ffffff; color: #1a1a1a; }
QListWidget::item, QListView::item { padding: 2px 6px; }
QListWidget::item:selected, QListView::item:selected { background-color: #35507c; color: #ffffff; }

QScrollArea { background-color: #ffffff; border: 1px solid #b3b2ad; }
QSplitter::handle { background-color: #b3b2ad; min-width: 3px; }

QScrollBar { background: transparent; border: none; }
QScrollBar::handle { background-color: #b3b2ad; border-radius: 0; min-width: 10px; min-height: 10px; }

QComboBox QAbstractItemView {
    background-color: #ffffff; color: #1a1a1a;
    selection-background-color: #35507c; selection-color: #ffffff;
}
QComboBox {
    background-color: #ffffff; color: #1a1a1a;
    border: 1px solid #7f7f79; border-radius: 0px; padding: 3px 6px;
}

QTableWidget { background-color: #ffffff; color: #1a1a1a; gridline-color: #b3b2ad; border: 1px solid #b3b2ad; }
QTableWidget::item:selected { background-color: #35507c; color: #ffffff; }
QHeaderView::section { background-color: #ecebe8; color: #1a1a1a; border: 1px solid #b3b2ad; padding: 4px; }

QTabBar::tab {
    background-color: #d6d4ce;
    color: #6e6d68;
    border: 1px solid #b3b2ad;
    border-bottom: none;
    padding: 4px 12px;
    margin-right: 0px;
}
QTabBar::tab:selected {
    background-color: #ecebe8;
    color: #1a1a1a;
}
QTabBar::tab:hover:!selected {
    background-color: #dddcd7;
}

QStatusBar {
    background-color: #ecebe8;
    color: #6e6d68;
}

QMenuBar {
    background-color: #ecebe8;
    color: #1a1a1a;
}
QMenuBar::item:selected {
    background-color: #d6d4ce;
}

QMenu {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #b3b2ad;
}
QMenu::item:selected {
    background-color: #35507c;
    color: #ffffff;
}

QGroupBox {
    color: #1a1a1a;
    border: 1px solid #b3b2ad;
    border-radius: 0px;
    margin-top: 8px;
    padding-top: 8px;
}

QToolTip {
    background-color: #ffffdc;
    color: #1a1a1a;
    border: 1px solid #b3b2ad;
}

QToolBar {
    background-color: #ecebe8;
    border-bottom: 1px solid #b3b2ad;
}

#tab-button { padding: 2px 10px; border-radius: 0; min-height: 0; }
#welcome-title { color: #1a1a1a; font-size: 28px; font-weight: bold; }
#welcome-sub { color: #1a1a1a; font-size: 14px; }
