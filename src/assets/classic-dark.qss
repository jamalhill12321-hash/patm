/* PATM Classic Dark — Qt QSS */
/* palette: window_bg=#2b2b28 base=#232320 text=#e4e3df highlight=#7ba2d8 */

QMainWindow, QDialog {
    background-color: #2b2b28;
    color: #e4e3df;
}

QLabel { color: #e4e3df; }
QLabel:disabled { color: #6f6e69; }

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #232320;
    color: #e4e3df;
    border: 1px solid #6d6c66;
    border-radius: 0px;
    padding: 3px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: #7ba2d8; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #2b2b28; color: #6f6e69;
}
QLineEdit::placeholderText { color: #767571; }

QSpinBox, QDoubleSpinBox {
    background-color: #232320; color: #e4e3df;
    border: 1px solid #6d6c66; border-radius: 0px; padding: 3px 6px;
}

QPushButton {
    background-color: #37362f;
    color: #e4e3df;
    border: 1px solid #6d6c66;
    border-radius: 0px;
    padding: 4px 12px;
}
QPushButton:hover { background-color: #45443f; }
QPushButton:pressed, QPushButton:checked { background-color: #33322c; }
QPushButton:disabled { background-color: #2b2b28; color: #6f6e69; }

QToolButton {
    background-color: #37362f;
    color: #e4e3df;
    border: 1px solid #6d6c66;
    border-radius: 0px;
    padding: 4px 12px;
}
QToolButton:hover { background-color: #45443f; }
QToolButton:pressed, QToolButton:checked { background-color: #33322c; }
QToolButton:disabled { background-color: #2b2b28; color: #6f6e69; }

QListWidget, QListView { background-color: #232320; color: #e4e3df; }
QListWidget::item, QListView::item { padding: 2px 6px; }
QListWidget::item:selected, QListView::item:selected { background-color: #31517e; color: #ffffff; }

QScrollArea { background-color: #232320; border: 1px solid #55544e; }
QSplitter::handle { background-color: #55544e; min-width: 3px; }

QScrollBar { background: transparent; border: none; }
QScrollBar::handle { background-color: #55544e; border-radius: 0; min-width: 10px; min-height: 10px; }

QComboBox QAbstractItemView {
    background-color: #232320; color: #e4e3df;
    selection-background-color: #31517e; selection-color: #ffffff;
}
QComboBox {
    background-color: #232320; color: #e4e3df;
    border: 1px solid #6d6c66; border-radius: 0px; padding: 3px 6px;
}

QTableWidget { background-color: #232320; color: #e4e3df; gridline-color: #55544e; border: 1px solid #55544e; }
QTableWidget::item:selected { background-color: #31517e; color: #ffffff; }
QHeaderView::section { background-color: #2b2b28; color: #e4e3df; border: 1px solid #55544e; padding: 4px; }

QTabBar::tab {
    background-color: #3a3a36;
    color: #8a8985;
    border: 1px solid #55544e;
    border-bottom: none;
    padding: 4px 12px;
    margin-right: 0px;
}
QTabBar::tab:selected {
    background-color: #2b2b28;
    color: #e4e3df;
}
QTabBar::tab:hover:!selected {
    background-color: #45443f;
}

QStatusBar {
    background-color: #2b2b28;
    color: #8a8985;
}

QMenuBar {
    background-color: #2b2b28;
    color: #e4e3df;
}
QMenuBar::item:selected {
    background-color: #45443f;
}

QMenu {
    background-color: #232320;
    color: #e4e3df;
    border: 1px solid #55544e;
}
QMenu::item:selected {
    background-color: #31517e;
    color: #ffffff;
}

QGroupBox {
    color: #e4e3df;
    border: 1px solid #55544e;
    border-radius: 0px;
    margin-top: 8px;
    padding-top: 8px;
}

QToolTip {
    background-color: #232320;
    color: #e4e3df;
    border: 1px solid #55544e;
}

QToolBar {
    background-color: #2b2b28;
    border-bottom: 1px solid #55544e;
}

#tab-button { padding: 2px 10px; border-radius: 0; min-height: 0; }
#welcome-title { color: #e4e3df; font-size: 28px; font-weight: bold; }
#welcome-sub { color: #e4e3df; font-size: 14px; }
