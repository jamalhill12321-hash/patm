/* PATM Breeze Light — Qt QSS */
/* palette: window_bg=#f7f7f7 base=#ffffff text=#232629 highlight=#3daee9 */

QMainWindow, QDialog {
    background-color: #f7f7f7;
    color: #232629;
}

QLabel { color: #232629; }
QLabel:disabled { color: #a8adb3; }

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #232629;
    border: 1px solid #b6bcc4;
    border-radius: 2px;
    padding: 3px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: #3daee9; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #f7f7f7; color: #a8adb3; border-color: #e0e3e6;
}
QLineEdit::placeholderText { color: #9aa1a8; }

QSpinBox, QDoubleSpinBox {
    background-color: #ffffff; color: #232629;
    border: 1px solid #b6bcc4; border-radius: 2px; padding: 3px 6px;
}

QPushButton {
    background-color: #fbfbfc;
    color: #232629;
    border: 1px solid #cfd3d8;
    border-radius: 2px;
    padding: 3px 14px;
}
QPushButton:hover { background-color: #edeff1; border-color: #cfd3d8; }
QPushButton:pressed { background-color: #e2e5e8; }
QPushButton:checked { background-color: #3daee9; border-color: #3daee9; color: #fcfcfc; }
QPushButton:disabled { background-color: #f7f7f7; color: #a8adb3; border-color: #e0e3e6; }

QToolButton {
    background-color: #fbfbfc;
    color: #232629;
    border: 1px solid #cfd3d8;
    border-radius: 2px;
    padding: 3px 14px;
}
QToolButton:hover { background-color: #edeff1; border-color: #cfd3d8; }
QToolButton:pressed { background-color: #e2e5e8; }
QToolButton:checked { background-color: #3daee9; border-color: #3daee9; color: #fcfcfc; }
QToolButton:disabled { background-color: #f7f7f7; color: #a8adb3; border-color: #e0e3e6; }

QListWidget, QListView { background-color: #ffffff; color: #232629; }
QListWidget::item, QListView::item { padding: 2px 6px; }
QListWidget::item:selected, QListView::item:selected { background-color: #3daee9; color: #fcfcfc; }

QScrollArea { background-color: #ffffff; border: 1px solid #dfe1e5; }
QSplitter::handle { background-color: #e0e3e6; min-width: 2px; min-height: 2px; }

QScrollBar { background: transparent; border: none; }
QScrollBar::handle { background-color: #ccd1d6; border-radius: 5px; min-width: 8px; min-height: 8px; }
QScrollBar::handle:hover { background-color: #b8bec4; }

QComboBox QAbstractItemView {
    background-color: #ffffff; color: #232629;
    selection-background-color: #3daee9; selection-color: #fcfcfc;
}
QComboBox {
    background-color: #ffffff; color: #232629;
    border: 1px solid #b6bcc4; border-radius: 2px; padding: 3px 6px;
}

QTableWidget { background-color: #ffffff; color: #232629; gridline-color: #dfe1e5; border: 1px solid #dfe1e5; }
QTableWidget::item:selected { background-color: #3daee9; color: #fcfcfc; }
QHeaderView::section { background-color: #f7f7f7; color: #232629; border: 1px solid #dfe1e5; padding: 4px; }

QTabBar::tab {
    background-color: #eceef0;
    color: #8c929a;
    border: 1px solid #dfe1e5;
    border-bottom: none;
    padding: 4px 12px;
    margin-right: 1px;
}
QTabBar::tab:selected {
    background-color: #f7f7f7;
    color: #232629;
}
QTabBar::tab:hover:!selected {
    background-color: #e2e5e8;
}

QStatusBar {
    background-color: #f7f7f7;
    color: #8c929a;
}

QMenuBar {
    background-color: #f7f7f7;
    color: #232629;
}
QMenuBar::item:selected {
    background-color: #e2e5e8;
}

QMenu {
    background-color: #ffffff;
    color: #232629;
    border: 1px solid #dfe1e5;
}
QMenu::item:selected {
    background-color: #3daee9;
    color: #fcfcfc;
}

QGroupBox {
    color: #232629;
    border: 1px solid #dfe1e5;
    border-radius: 2px;
    margin-top: 8px;
    padding-top: 8px;
}

QToolTip {
    background-color: #ffffff;
    color: #232629;
    border: 1px solid #dfe1e5;
}

QToolBar {
    background-color: #f7f7f7;
    border-bottom: 1px solid #dfe1e5;
}

#tab-button { padding: 2px 10px; border-radius: 0; min-height: 0; }
#welcome-title { color: #232629; font-size: 28px; font-weight: bold; }
#welcome-sub { color: #232629; font-size: 14px; }
