/* PATM Fusion Dark — Qt QSS */
/* palette: window_bg=#31363b base=#232629 text=#fcfcfc button_bg=#31363b */
/* highlight=#3daee9 selection_bg=#3daee9 selection_text=#fcfcfc */

QMainWindow, QDialog {
    background-color: #31363b;
    color: #fcfcfc;
}

QLabel { color: #fcfcfc; }
QLabel:disabled { color: #6e7175; }

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #232629;
    color: #fcfcfc;
    border: 1px solid #565b60;
    border-radius: 2px;
    padding: 3px 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: #3daee9; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #31363b; color: #6e7175; border-color: #40464b;
}
QLineEdit::placeholderText { color: #76797c; }

QSpinBox, QDoubleSpinBox {
    background-color: #232629;
    color: #fcfcfc;
    border: 1px solid #565b60;
    border-radius: 2px;
    padding: 3px 6px;
}

QPushButton {
    background-color: #31363b;
    color: #fcfcfc;
    border: 1px solid #565b60;
    border-radius: 2px;
    padding: 3px 14px;
}
QPushButton:hover { background-color: #3b4247; border-color: #3daee9; }
QPushButton:pressed { background-color: #282d31; }
QPushButton:checked { background-color: #282d31; border-color: #3daee9; color: #fcfcfc; }
QPushButton:disabled { background-color: #31363b; color: #6e7175; border-color: #40464b; }

QToolButton {
    background-color: #31363b;
    color: #fcfcfc;
    border: 1px solid #565b60;
    border-radius: 2px;
    padding: 3px 14px;
}
QToolButton:hover { background-color: #3b4247; border-color: #3daee9; }
QToolButton:pressed { background-color: #282d31; }
QToolButton:checked { background-color: #282d31; border-color: #3daee9; color: #fcfcfc; }
QToolButton:disabled { background-color: #31363b; color: #6e7175; border-color: #40464b; }

QListWidget, QListView {
    background-color: #232629;
    color: #fcfcfc;
}
QListWidget::item, QListView::item { padding: 2px 6px; }
QListWidget::item:selected, QListView::item:selected {
    background-color: #3daee9;
    color: #fcfcfc;
}

QScrollArea { background-color: #232629; border: 1px solid #43494e; }
QSplitter::handle { background-color: #40464b; min-width: 2px; min-height: 2px; }

QScrollBar { background: transparent; border: none; }
QScrollBar::handle { background-color: #4a5055; min-width: 10px; min-height: 10px; border: 1px solid #565b60; }
QScrollBar::handle:hover { background-color: #5c6368; }

QComboBox QAbstractItemView {
    background-color: #232629;
    color: #fcfcfc;
    selection-background-color: #3daee9;
    selection-color: #fcfcfc;
}
QComboBox {
    background-color: #232629;
    color: #fcfcfc;
    border: 1px solid #565b60;
    border-radius: 2px;
    padding: 3px 6px;
}

QTableWidget {
    background-color: #232629;
    color: #fcfcfc;
    gridline-color: #43494e;
    border: 1px solid #43494e;
}
QTableWidget::item:selected { background-color: #3daee9; color: #fcfcfc; }
QHeaderView::section {
    background-color: #31363b;
    color: #fcfcfc;
    border: 1px solid #43494e;
    padding: 4px;
}

QTabBar::tab {
    background-color: #282d31;
    color: #a0a5a9;
    border: 1px solid #43494e;
    border-bottom: none;
    padding: 4px 12px;
    margin-right: 1px;
}
QTabBar::tab:selected {
    background-color: #31363b;
    color: #fcfcfc;
}
QTabBar::tab:hover:!selected {
    background-color: #3b4247;
}

QStatusBar {
    background-color: #31363b;
    color: #a0a5a9;
}

QMenuBar {
    background-color: #31363b;
    color: #fcfcfc;
}
QMenuBar::item:selected {
    background-color: #3b4247;
}

QMenu {
    background-color: #232629;
    color: #fcfcfc;
    border: 1px solid #43494e;
}
QMenu::item:selected {
    background-color: #3daee9;
    color: #fcfcfc;
}

QGroupBox {
    color: #fcfcfc;
    border: 1px solid #43494e;
    border-radius: 2px;
    margin-top: 8px;
    padding-top: 8px;
}

QToolTip {
    background-color: #232629;
    color: #fcfcfc;
    border: 1px solid #43494e;
}

QToolBar {
    background-color: #31363b;
    border-bottom: 1px solid #43494e;
}

#tab-button { padding: 2px 10px; border-radius: 0; min-height: 0; }
#welcome-title { color: #fcfcfc; font-size: 28px; font-weight: bold; }
#welcome-sub { color: #fcfcfc; font-size: 14px; }
